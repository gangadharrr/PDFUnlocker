{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**",
          "src/python/**",
          "python/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/health",
      "dest": "dist/index.js"
    },
    {
      "src": "/api/v1/unlock",
      "dest": "dist/index.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "dist/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
